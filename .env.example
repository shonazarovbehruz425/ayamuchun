# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# AI Engine (Multi-provider: gemini, openai, deepseek, groq, custom)
AI_PROVIDER=gemini
AI_API_KEY=your_ai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# AI_BASE_URL: Moslashuvchan formatlar (https://api.b.ai/v1/chat/completions, https://api.b.ai/v1 yoki https://api.b.ai)
AI_BASE_URL=
AI_MODEL=gemini-2.0-flash
AI_DISPLAY_NAME=EduBot AI

# Telegram Cloud Storage Channels (Faqat ENV orqali o'rnatiladi, kodda oldindan yozilgan ID yo'q)
# 1. User files channel: Userlar yuborgan barcha PDF, Word, Excel, 3x4 rasmlar saqlanadigan kanal ID si
FILES_CHANNEL_ID=-100XXXXXXXXXX

# 2. Database backup channel: SQLite ma'lumotlar bazasi zaxirasi (.js) saqlanadigan kanal ID si
DATABASE_CHANNEL_ID=-100XXXXXXXXXX

# External Persistent Database URL (Optional: Neon / Supabase / Render Postgres)
# If provided, EduBot stores all tables directly here and never loses data on redeploys!
# DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname

# Web App
WEBAPP_URL=https://yourdomain.com
API_HOST=0.0.0.0
API_PORT=8000

# Storage
STORAGE_PATH=./storage
