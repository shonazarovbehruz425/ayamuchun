# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/edubot.db

# Web App
WEBAPP_URL=https://yourdomain.com
API_HOST=0.0.0.0
API_PORT=8000

# Webhook (optional, use polling for development)
WEBHOOK_URL=
WEBHOOK_PORT=8443

# Storage
STORAGE_PATH=./storage
